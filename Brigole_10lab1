Brigole_flavor = input("Enter pizza flavor (Hawaiian/Pepperoni/Cheese/Cookies/Oreo): ").lower()

match Brigole_flavor:
    case "hawaiian":
        print("You selected Hawaiian Pizza.")
    case "pepperoni":
        print("You selected Pepperoni Pizza.")
    case "cheese":
        print("You selected Cheese Pizza.")
    case "cookies":
        print("You selected Cookies Pizza.")
    case "oreo":
        print("You selected Oreo Pizza.")
    case _:
        print("Invalid Pizza Flavor")

Brigole_size = input("Enter size (Small/Medium/Large): ").lower()

Brigole_price = 0

match Brigole_size:
    case "small":
        Brigole_price = 250
    case "medium":
        Brigole_price = 350
    case "large":
        Brigole_price = 450
    case _:
        print("Invalid Pizza Size")

if Brigole_price > 0:
    print("Pizza Price:", Brigole_price)
